-- conversion logic
local function convertToAccessory()
    local selection = Selection:Get()[1]
    if not selection or not selection:IsA("Model") then
        status.Text = "No model selected"
        return
    end

    if rigButton.Text == "Choose..." then
        status.Text = "Pick a rig first"
        return
    end

    if accButton.Text == "Choose..." then
        status.Text = "Pick an accessory type"
        return
    end

    local attachmentName = accButton.Text

    -- collect parts
    local parts = {}
    for _, obj in ipairs(selection:GetDescendants()) do
        if obj:IsA("BasePart") then
            table.insert(parts, obj:Clone())
        end
    end

    if #parts == 0 then
        status.Text = "Model has no parts"
        return
    end

    -- accessory + handle
    local accessory = Instance.new("Accessory")
    accessory.Name = selection.Name .. "_Accessory"

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(1,1,1)
    handle.CFrame = parts[1].CFrame
    handle.Transparency = 0.7
    handle.Parent = accessory

    -- weld parts into handle
    for _, part in ipairs(parts) do
        part.Parent = handle
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = handle
        weld.Part1 = part
        weld.Parent = handle
    end

    -- attachment
    local attachment = Instance.new("Attachment")
    attachment.Name = attachmentName
    attachment.Parent = handle

    accessory.Parent = workspace
    status.Text = "Converted successfully"
end

convert.MouseButton1Click:Connect(convertToAccessory)

